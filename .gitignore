# macOS
.DS_Store

# VS Code user-local state
.vscode/*.log

# Former IntelliSense build path. Generated output now lives in build/, which
# is ignored below. Kept ignored so a leftover copy on any machine stays out of
# the repository.
.vscode/arduino-build/

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Generated logger data
data/*.csv
data/*.json
data/*.log

# Temporary files
*.tmp
*.swp
*~
.upload-in-progress
.serial-command

# Arduino build output. build/intellisense/ is the compilation database and
# preprocessed sketch generated by tools/intellisense.sh.
build/
Arduino/build/