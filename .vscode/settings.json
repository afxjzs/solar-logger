{
	"files.associations": {
		"*.ino": "cpp"
	},

	// --- C/C++ IntelliSense -------------------------------------------------
	//
	// The configuration itself lives in .vscode/c_cpp_properties.json and is
	// generated by tools/intellisense.sh. These three settings exist because
	// the generated build output sits inside the workspace and cpptools would
	// otherwise index it.
	//
	// build/intellisense/sketch/solar-logger.ino.cpp is a ~250 KB generated
	// near-duplicate of the sketch: every function in it would appear twice in
	// the symbol database, once from the file you edit and once from the file
	// the compiler sees.
	//
	// These keys are resource-scoped, so they still apply when the folder is
	// opened through solar-charger.code-workspace.
	//
	// The two ".vs" entries are cpptools' own defaults, repeated here on
	// purpose: it is not documented whether an extension-contributed object
	// setting is merged with its default or replaced by it, and losing the
	// .vscode exclusion would quietly index the stale generated sketch left in
	// .vscode/arduino-build by the previous tooling. Stating all three costs
	// two lines and does not depend on the answer.
	"C_Cpp.files.exclude": {
		"**/.vscode": true,
		"**/.vs": true,
		"**/build/**": true
	},
	"files.watcherExclude": {
		"**/build/**": true
	},
	"search.exclude": {
		"**/build/**": true
	},

	// cpptools defaults this to "enabledIfIncludesResolve", which silently
	// suppresses every other error whenever an #include fails to resolve. That
	// is how a broken include path hid a hundred undeclared-identifier errors
	// in this sketch for as long as it did. tools/intellisense.sh proves the
	// include path resolves before it writes the database, so there is nothing
	// left for the default to protect us from - and a suppressed error is a
	// silent failure.
	"C_Cpp.errorSquiggles": "enabled",

	"chat.tools.terminal.autoApprove": {
		"/^uv run python -m py_compile app/solar_logger\\.py$/": {
			"approve": true,
			"matchCommandLine": true
		},
		"/^arduino-cli compile --fqbn esp32:esp32:XIAO_ESP32C3 Arduino/solar-logger$/": {
			"approve": true,
			"matchCommandLine": true
		},
		"/^bash -n tools/upload\\.sh$/": {
			"approve": true,
			"matchCommandLine": true
		},
		"/^bash -n tools/send\\.sh$/": {
			"approve": true,
			"matchCommandLine": true
		},
		"uv": true
	}
}
