{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Solar Logger: Compile",
      "type": "shell",
      "command": "arduino-cli",
      "args": [
        "compile",
        "--warnings",
        "all",
        "--fqbn",
        "esp32:esp32:XIAO_ESP32C3",
        "${workspaceFolder}/Arduino/solar-logger"
      ],
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Solar Logger: Upload",
      "type": "shell",
      "command": "${workspaceFolder}/tools/upload.sh",
      "problemMatcher": []
    },
    {
      "label": "Solar Logger: Generate IntelliSense Database",
      "detail": "Run after adding an #include or a new forward reference in the sketch.",
      "type": "shell",
      "command": "${workspaceFolder}/tools/intellisense.sh",
      "problemMatcher": []
    },
    {
      "label": "Solar Logger: Check IntelliSense Database",
      "detail": "Fast: reports whether the database still matches the sketch.",
      "type": "shell",
      "command": "${workspaceFolder}/tools/intellisense.sh",
      "args": [
        "--check"
      ],
      "problemMatcher": []
    }
  ]
}
